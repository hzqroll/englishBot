APP_NAME=English Learning QQ Bot
ENV=production
HOST=0.0.0.0
PORT=8080
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN=replace-with-onebot-access-token
DATABASE_URL=sqlite+aiosqlite:///./data/english_bot.sqlite3
CONFIG_PATH=./config.yaml
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-admin-password
TENCENT_TRANSLATE_SECRET_ID=
TENCENT_TRANSLATE_SECRET_KEY=
TENCENT_TRANSLATE_REGION=ap-beijing
TENCENT_TRANSLATE_ENDPOINT=tmt.tencentcloudapi.com
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
CADDY_HTTP_PORT=80
NAPCAT_WEBUI_PORT=6099
NAPCAT_UID=1000
NAPCAT_GID=1000
