[Unit]
Description=EnglishBot Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/apps/englishbot/current
EnvironmentFile=/home/ubuntu/apps/englishbot/shared/.env
ExecStart=/home/ubuntu/apps/englishbot/current/.venv/bin/python -m src.main
Restart=always
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGINT
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
